products: {
  shape: sql_table

  id: int {constraint: primary_key}
  store_id: int {constraint: foreign_key}
  category_id: int {constraint: foreign_key}
  name: varchar
  description: text
  price: decimal
  stock: int
  status: varchar
  created_at: timestamp
}

product_images: {
  shape: sql_table

  id: int {constraint: primary_key}
  product_id: int {constraint: foreign_key}
  image_url: varchar
  alt_text: varchar
  position: int
}
