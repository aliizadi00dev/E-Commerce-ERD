...@styles

database: SQL Schema {
  shape: cylinder
  style: {
    font-size: 55
    bold: true
    stroke-width: 8
  }

  ...@entities/users
  ...@entities/products
  ...@entities/stores
  ...@entities/carts
  ...@entities/wallets
  ...@entities/categories
  ...@entities/payments
  ...@entities/orders
  ...@relationships
}
